#!/usr/bin/env bash
# aligner - setup and run for ocr-text-aligner
# Usage: aligner run   (creates venv if needed, activates if not, installs requirements)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="${SCRIPT_DIR}/venv"
REQUIREMENTS="${SCRIPT_DIR}/requirements.txt"

cd "$SCRIPT_DIR"

run() {
  if [[ ! -d "$VENV_DIR" ]]; then
    echo "Creating virtual environment at ${VENV_DIR}..."
    python3 -m venv "$VENV_DIR"
  fi

  echo "Installing requirements..."
  "${VENV_DIR}/bin/pip" install -r "$REQUIREMENTS"

  if [[ -z "${VIRTUAL_ENV}" || "${VIRTUAL_ENV}" != "${VENV_DIR}" ]]; then
    echo ""
    echo "Virtual environment ready. To activate it, run:"
    echo "  source venv/bin/activate"
  else
    echo "Virtual environment is active and requirements are installed."
  fi
}

case "${1:-}" in
  run) run ;;
  *)
    echo "Usage: aligner run"
    echo "  Creates the venv (if it doesn't exist), installs requirements."
    echo "  After running, activate with: source venv/bin/activate"
    exit 1
    ;;
esac
